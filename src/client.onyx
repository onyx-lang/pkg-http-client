package http.client

use http
use core {sync, time, string, iter, alloc, Result, tprintf, io}

Client :: struct {
    transport: &Transport = Default_Transport.make()

    default_headers: Headers = Headers.make()

    cookies: CookieJar = CookieJar.make()

    default_timeout := 10 * time.SECOND
    connect_timeout := 10 * time.SECOND
    read_timeout := 10 * time.SECOND
    idle_timeout := 90 * time.SECOND

    max_redirects := 10

    // Empty proxy uses HTTP_PROXY / HTTPS_PROXY / NO_PROXY when use_env_proxy is set.
    proxy: str
    use_env_proxy := true

    // Empty ca_pem uses the bundled Mozilla store. insecure_skip_verify skips it.
    ca_pem: str
    insecure_skip_verify := false
    server_name: str
    client_cert_pem: str
    client_key_pem: str

    cancel: &CancelFlag
}

Client.free :: (c: &Client) {
    c.default_headers->free()
    c.cookies->free()
    c.transport->free()
}

Client.send :: (c: &Client, req: &Request) -> Result(&Response, Error) {
    return send_following(c, req, false)
}

Client.open :: (c: &Client, req: &Request) -> Result(&Response, Error) {
    return send_following(c, req, true)
}

#local
send_following :: (c: &Client, req: &Request, stream: bool) -> Result(&Response, Error) {
    if !req.headers->has("user-agent") {
        req.headers->set("user-agent", tprintf("onyx-http-client/{}", Version))
    }

    current := req
    owned: &Request = null
    defer if owned do owned->free()

    followed := 0
    while true {
        apply_client_options(c, current)
        if request_cancelled(current) do return .{ Err = .Cancelled }

        prev := current.stream_response
        current.stream_response = stream
        resp := c.transport->send_request(current)
        current.stream_response = prev
        if resp.Err do return resp

        parsed := resp.Ok->unwrap()
        parsed.url = format_url(current.url)
        if parsed.headers->has("set-cookie") {
            c.cookies->ingress_from_headers(parsed.headers, current.url)
        }

        location := parsed.headers->get("location")
        if c.max_redirects == 0 || !location || !is_redirect_status(parsed.status) {
            return resp
        }

        if followed >= c.max_redirects {
            parsed->free()
            return .{ Err = .TooManyRedirects }
        }

        next_url := resolve_redirect(current.url, location)
        if !next_url {
            return resp
        }

        next_method := method_for_redirect(parsed.status, current.method)
        if next_method == current.method && current.body_stream {
            if current.body_stream->seek(0, io.SeekFrom.Start) != .None {
                parsed->free()
                return .{ Err = .UnrewindableBody }
            }
        }

        followed += 1
        next := redirect_request(c, current, parsed.status, next_url)
        parsed->free()

        if owned do owned->free()
        owned = next
        current = next
    }

    return .{ Err = .TooManyRedirects }
}

Client.new_request :: #match {
    (c: &Client) -> &Request {
        req := http.client.new_request()
        req.headers = c.default_headers->clone()
        req.cookies = c.cookies->clone()
        req.timeout = c.default_timeout
        req.connect_timeout = c.connect_timeout
        req.read_timeout = c.read_timeout
        req.cancel = c.cancel
        return req
    },

    (c: &Client, method: Method, url: str) -> &Request {
        req := http.client.new_request(method, url)
        req.headers = c.default_headers->clone()
        req.cookies = c.cookies->clone()
        req.timeout = c.default_timeout
        req.connect_timeout = c.connect_timeout
        req.read_timeout = c.read_timeout
        req.cancel = c.cancel
        return req
    }
}

Client.get :: #match {
    (c: &Client, url: str, query_params: [] QueryParam) -> Result(&Response, Error) {
        q := Query.{}
        defer q->free()

        for & query_params do q->set(it.key, it.value)

        return c->get(url, &q)
    },

    (c: &Client, url: str, query: &Query = null) -> Result(&Response, Error) {
        req := c->new_request(.Get, url)
        defer req->free()

        if query do req->set_query(query)

        return c->send(req)
    },
}

Client.post :: (c: &Client, url: str, content_type: str, data: [] u8) -> Result(&Response, Error) {
    req := c->new_request(.Post, url)
    req.headers->set("content-type", content_type)
    req.body = data

    defer req->free()

    return c->send(req)
}

is_redirect_status :: (status: u32) -> bool {
    return status == 301 || status == 302 || status == 303 || status == 307 || status == 308
}

method_for_redirect :: (status: u32, method: Method) -> Method {
    if method == .Get || method == .Head do return method
    if status == 301 || status == 302 || status == 303 do return .Get
    return method
}

idempotent_method :: (method: Method) -> bool {
    if method == .Get || method == .Head || method == .Options do return true
    if method == .Trace || method == .Put || method == .Delete do return true
    return false
}

// A reused connection is retried when the send itself failed, or when an
// idempotent method failed before a response could be trusted.
should_retry_reused :: (method: Method, custom: str, streamed: bool, err: Error) -> bool {
    if streamed do return false
    if err == .WriteFailed do return true
    if custom do return false
    if !idempotent_method(method) do return false
    return err == .Timeout || err == .ResponseParseFailed || err == .ConnectionFailed
}

#local
redirect_request :: (c: &Client, req: &Request, status: u32, next_url: str) -> &Request {
    parsed := destructure_url(next_url)->unwrap()
    method := method_for_redirect(status, req.method)

    cross_host := !str.equal_insensitive(req.url.host, parsed.host)

    next := alloc.on_heap(Request.{
        method = method,
        headers = req.headers->clone(),
        url = parsed,
        cookies = c.cookies->clone(),
        timeout = req.timeout,
        connect_timeout = req.connect_timeout,
        read_timeout = req.read_timeout,
        url_storage = next_url,
        cancel = req.cancel,
    })

    if cross_host do next.cookies->drop_any_host()

    for iter.as_iter(&req.cookies.cookies) {
        if cross_host && it.value.any_host do continue
        next.cookies->set(it.value)
    }

    method_changed := method != req.method
    if method_changed {
        next.body = .{}
        next.body_stream = null
        next.form = null
        next.custom_method = ""
        next.headers->delete("content-type")
        next.headers->delete("content-length")
        next.headers->delete("transfer-encoding")
    } else {
        next.body = req.body
        next.body_stream = req.body_stream
        next.body_length = req.body_length
        next.form = req.form
        next.custom_method = req.custom_method
    }

    if cross_host {
        next.headers->delete("authorization")
        next.headers->delete("cookie")
        next.headers->delete("proxy-authorization")
    }

    return next
}

default_client: Client
#local default_client_init_once: sync.Once
#local init_default_client :: () {
    default_client = .{}
}

get :: #match #local {}

#overload
get :: (url: str, query_params: [] QueryParam) -> Result(&Response, Error) {
    default_client_init_once->exec(init_default_client)

    return default_client->get(url, query_params)
}

#overload
get :: (url: str, query: &Query = null) -> Result(&Response, Error) {
    default_client_init_once->exec(init_default_client)

    return default_client->get(url, query)
}

apply_client_options :: (c: &Client, req: &Request) {
    req.idle_timeout = c.idle_timeout
    req.ca_pem = c.ca_pem
    req.insecure = c.insecure_skip_verify
    req.server_name = c.server_name
    req.client_cert_pem = c.client_cert_pem
    req.client_key_pem = c.client_key_pem
    req.proxy = c.proxy
    req.use_env_proxy = c.use_env_proxy
    if !req.cancel do req.cancel = c.cancel
    if cast(i64) req.connect_timeout == 0 do req.connect_timeout = c.connect_timeout
    if cast(i64) req.read_timeout == 0 do req.read_timeout = c.read_timeout
    if req.url.user && !req.headers->has("authorization") {
        req->set_basic_auth(req.url.user, req.url.pass)
    }
}

request_cancelled :: (req: &Request) -> bool {
    if req.cancel && req.cancel.cancelled do return true
    return false
}

Client.head :: (c: &Client, url: str) -> Result(&Response, Error) {
    req := c->new_request(.Head, url)
    defer req->free()
    return c->send(req)
}

Client.put :: (c: &Client, url: str, content_type: str, data: [] u8) -> Result(&Response, Error) {
    return c->send_body(.Put, url, content_type, data)
}

Client.patch :: (c: &Client, url: str, content_type: str, data: [] u8) -> Result(&Response, Error) {
    return c->send_body(.Patch, url, content_type, data)
}

Client.delete :: (c: &Client, url: str) -> Result(&Response, Error) {
    req := c->new_request(.Delete, url)
    defer req->free()
    return c->send(req)
}

#local
Client.send_body :: (c: &Client, method: Method, url: str, content_type: str, data: [] u8) -> Result(&Response, Error) {
    req := c->new_request(method, url)
    req.headers->set("content-type", content_type)
    req.body = data
    defer req->free()
    return c->send(req)
}

post :: (url: str, content_type: str, data: [] u8) -> Result(&Response, Error) {
    default_client_init_once->exec(init_default_client)

    return default_client->post(url, content_type, data)
}
