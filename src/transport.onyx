package http.client

use core {package, net, io, sync, alloc, iter, time, hash, Result}
use openssl {*}

Transport :: struct {
    use __vtable: &Transport_Vtable;
}

Transport_Vtable :: struct {
    send_request: (&Transport, &Request) -> Result(&Response, Error);
    free: (&Transport) -> void;
}

Conn_Key :: struct {
    host: str;
    port: u32;
    https: bool;

    hash :: (k: Conn_Key) -> u32 {
        h := core.hash.hash(k.host);
        h = (h * 16777619) + k.port;
        if k.https do h += 1;
        return h;
    }
}

#operator == (a, b: Conn_Key) -> bool {
    return a.port == b.port && a.https == b.https && a.host == b.host;
}

Default_Transport :: struct {
    use base: Transport;

    initializeOnce: sync.Once;

    ssl_ctx: SSL_CTX;
    open_sockets: Map(Conn_Key, Default_Transport_Connection);
}

Default_Transport.make :: () -> &Default_Transport {
    return alloc.on_heap(Default_Transport.{
        Transport.{ &default_transport_vtable }
    });
}

default_transport_vtable := Transport_Vtable.{
    send_request = default_send_request,
    free = default_transport_free
}

#local
default_transport_initialize :: (dt: &Default_Transport) {
    Map.init(&dt.open_sockets, alloc.heap_allocator);

    dt.ssl_ctx = SSL_CTX_new(TLS_client_method());
    if cast(u64, dt.ssl_ctx) == 0 {
        return;
    }

    SSL_CTX_set_verify(dt.ssl_ctx, SSL_VERIFY_PEER, null);
    SSL_CTX_set_verify_depth(dt.ssl_ctx, 4);
    SSL_CTX_set_options(dt.ssl_ctx, SSL_OP_NO_COMPRESSION | SSL_OP_NO_SESSION_RESUMPTION_ON_RENEGOTIATION);
    SSL_CTX_set_default_verify_paths(dt.ssl_ctx);
}

#local
default_transport_free :: (self: &Default_Transport) {
    for &self.open_sockets.entries {
        shutdown_connection(&it.value);
        if it.key.host do delete(&it.key.host);
    }

    delete(&self.open_sockets);

    if cast(u64, self.ssl_ctx) != 0 {
        SSL_CTX_free(self.ssl_ctx);
    }
}

#local
shutdown_connection :: (conn: &Default_Transport_Connection) {
    net.socket_close(&conn.socket);

    if conn.ssl {
        ssl := conn.ssl->unwrap();
        SSL_shutdown(ssl);
        SSL_free(ssl);
    }
}

#local
default_transport_close_connection :: (dt: &Default_Transport, key: Conn_Key) {
    conn := &dt.open_sockets[key];
    if !conn do return;

    host := conn.owned_host;
    socket := conn.socket;
    ssl := conn.ssl;

    dt.open_sockets->delete(key);

    closed := Default_Transport_Connection.{ socket, ssl, host };
    shutdown_connection(&closed);
    if host do delete(&host);
}

#local
default_transport_create_connection :: (t: &Default_Transport, req: &Request, use_https: bool) -> Result(Default_Transport_Connection, Error) {
    logf(.Debug, "Creating connection to {}", req.url.host);

    tc: Default_Transport_Connection;
    created := net.socket_create(.Inet, .Stream, .IP);
    if created.Err {
        return .{ Err = .ConnectionFailed };
    }
    tc.socket = created.Ok->unwrap();

    addr := net.SocketAddress.{ HostPort = .{ host = req.url.host, port = ~~req.url.port } };
    if err := tc.socket->connect(&addr); err != .None {
        net.socket_close(&tc.socket);
        return .{ Err = .ConnectionFailed };
    }

    if use_https {
        if cast(u64, t.ssl_ctx) == 0 {
            net.socket_close(&tc.socket);
            return .{ Err = .TlsError };
        }

        ssl := SSL_new(t.ssl_ctx);
        if cast(u64, ssl) == 0 {
            net.socket_close(&tc.socket);
            return .{ Err = .TlsError };
        }

        bio := BIO_new_socket(cast(u32, tc.socket.handle), BIO_NOCLOSE);
        if cast(u64, bio) == 0 {
            SSL_free(ssl);
            net.socket_close(&tc.socket);
            return .{ Err = .TlsError };
        }
        SSL_set_bio(ssl, bio, bio);

        host_z := core.tprintf(u8.[ '{', '}', 0 ], req.url.host);
        if SSL_set1_host(ssl, host_z.data) != 1 {
            SSL_free(ssl);
            net.socket_close(&tc.socket);
            return .{ Err = .TlsError };
        }

        if SSL_ctrl(ssl, SSL_CTRL_SET_TLSEXT_HOSTNAME, ~~ TLSEXT_NAMETYPE_host_name, host_z.data) == 0 {
            SSL_free(ssl);
            net.socket_close(&tc.socket);
            return .{ Err = .TlsError };
        }

        handshake_result := SSL_connect(ssl);
        if handshake_result <= 0 {
            err := SSL_get_error(ssl, handshake_result);
            log(.Error, "HTTPS", core.tprintf("SSL Error: code {}", err));
            SSL_free(ssl);
            net.socket_close(&tc.socket);
            return .{ Err = .TlsError };
        }

        if SSL_get_verify_result(ssl) != ~~X509_V_OK {
            SSL_free(ssl);
            net.socket_close(&tc.socket);
            return .{ Err = .TlsError };
        }

        tc.ssl->set(ssl);
    }

    return .{ Ok = tc };
}

#local
default_send :: (conn: &Default_Transport_Connection, req: &Request) -> bool {
    conn.socket->option(.NonBlocking, false);
    stream := conn->as_stream();

    w := io.writer_make(stream);
    write_successful := req->write(&w);
    io.writer_free(&w);

    return write_successful;
}

#local
default_send_request :: (t: &Default_Transport, req: &Request) -> Result(&Response, Error) {
    if req.url.protocol == .Unknown do return .{ Err = .InvalidUrl };
    t.initializeOnce->exec(t, default_transport_initialize);

    use_https := req.url.protocol == .HTTPS11;
    if use_https && cast(u64, t.ssl_ctx) == 0 {
        return .{ Err = .TlsError };
    }

    location := Conn_Key.{ req.url.host, req.url.port, use_https };
    reused := false;

    if t.open_sockets->has(location) {
        conn := &t.open_sockets[location];
        if default_send(conn, req) {
            reused = true;
        } else {
            default_transport_close_connection(t, location);
        }
    }

    if !reused {
        return send_on_new_connection(t, req, use_https);
    }

    result := read_response(t, location, req);
    if result.Err {
        err := result.Err->unwrap();
        if err == .Timeout || err == .ResponseParseFailed || err == .WriteFailed {
            if t.open_sockets->has(location) {
                default_transport_close_connection(t, location);
            }
            return send_on_new_connection(t, req, use_https);
        }
    }

    return result;
}

#local
send_on_new_connection :: (t: &Default_Transport, req: &Request, use_https: bool) -> Result(&Response, Error) {
    new_conn := default_transport_create_connection(t, req, use_https)?;
    owned_host := copy_str(req.url.host);
    new_conn.owned_host = owned_host;
    stored := Conn_Key.{ owned_host, req.url.port, use_https };
    t.open_sockets[stored] = new_conn;

    if !default_send(&t.open_sockets[stored], req) {
        default_transport_close_connection(t, stored);
        return .{ Err = .WriteFailed };
    }

    return read_response(t, stored, req);
}

#local
read_response :: (t: &Default_Transport, location: Conn_Key, req: &Request) -> Result(&Response, Error) {
    conn := &t.open_sockets[location];
    if !conn do return .{ Err = .ConnectionFailed };

    conn.socket->option(.NonBlocking, true);

    deadline := time.Instant.now() + req.timeout;
    ds := Read_Stream.make(conn, deadline);
    defer cfree(ds);

    r := io.reader_make(&ds.base);
    defer io.reader_free(&r);

    resp := parse_response(&r, req.method);
    if ds.timed_out {
        if resp.Ok do resp.Ok->unwrap()->free();
        default_transport_close_connection(t, location);
        return .{ Err = .Timeout };
    }

    if resp.Err {
        default_transport_close_connection(t, location);
        return resp;
    }

    parsed := resp.Ok->unwrap();
    if parsed.must_close {
        default_transport_close_connection(t, location);
    }

    return resp;
}

Default_Transport_Connection :: struct {
    socket: net.Socket;
    ssl: ? SSL;
    owned_host: str;
}

Default_Transport_Connection.as_stream :: (dtc: &#Self) -> &io.Stream {
    if !dtc.ssl {
        return &dtc.socket;
    }

    return alloc.on_temp(SSL_Stream.make(dtc.ssl?));
}

Read_Stream :: struct {
    use base: io.Stream;
    socket: &net.Socket;
    ssl: SSL;
    deadline: time.Instant;
    timed_out: bool;
}

Read_Stream.make :: (conn: &Default_Transport_Connection, deadline: time.Instant) -> &Read_Stream {
    s := new(Read_Stream);
    s.base = .{ &read_stream_vtable };
    s.socket = &conn.socket;
    s.deadline = deadline;
    if conn.ssl do s.ssl = conn.ssl?;
    return s;
}

read_stream_vtable := io.Stream_Vtable.{
    read = (s: &Read_Stream, buffer: [] u8) -> Result(u32, io.Error) {
        while true {
            if !read_stream_wait(s) do return .{ Err = .EOF };

            if cast(u64, s.ssl) != 0 {
                n := SSL_read(s.ssl, buffer.data, buffer.count);
                if n > 0 do return .{ Ok = n };

                err := SSL_get_error(s.ssl, n);
                if err == SSL_ERROR_WANT_READ || err == SSL_ERROR_WANT_WRITE do continue;
                return .{ Err = .EOF };
            }

            result := io.stream_read(s.socket, buffer);
            if result.Ok do return result;
            err := result.Err->unwrap();
            if err == .ReadLater || err == .ReadPending || err == .NoData do continue;
            return result;
        }

        return .{ Err = .EOF };
    },

    read_byte = (s: &Read_Stream) -> Result(u8, io.Error) {
        byte: [1] u8;
        n := io.stream_read(&s.base, byte)?;
        if n == 0 do return .{ Err = .EOF };
        return .{ Ok = byte[0] };
    },
};

#local
read_stream_wait :: (s: &Read_Stream) -> bool {
    if cast(u64, s.ssl) != 0 && SSL_pending(s.ssl) > 0 do return true;

    remaining := s.deadline - time.Instant.now();
    if remaining <= 0 {
        s.timed_out = true;
        return false;
    }

    ms := remaining->as_ms();
    if ms > 2000000000 do ms = 2000000000;
    status := s.socket->poll(~~ms);
    if status == .Readable do return true;

    s.timed_out = true;
    return false;
}
