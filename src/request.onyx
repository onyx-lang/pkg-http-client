package http.client

use core {package, alloc, io, time, conv}
use core.encoding.json
use core.encoding.base64

Request :: struct {
    allocator: Allocator

    method: Method
    headers: Headers

    body: ? [] u8
    body_stream: &io.Stream
    body_length: ? i64
    form: &FormData

    stream_response: bool
    use_absolute_form: bool

    url: Url
    cookies: CookieJar

    timeout := 10 * time.SECOND
    connect_timeout: time.Duration
    read_timeout: time.Duration
    idle_timeout: time.Duration

    cancel: &CancelFlag

    // TLS and proxy are copied from the Client for the attempt.
    ca_pem: str
    insecure: bool
    server_name: str
    client_cert_pem: str
    client_key_pem: str
    proxy: str
    use_env_proxy: bool
    proxy_authorization: str

    custom_method: str
    owned_method: str

    owned_query: str
    owned_body: str
    url_storage: str
}

//
// DO NOT USE THIS REQUEST CREATION METHOD UNLESS YOU KNOW
// WHAT YOU ARE DOING.
//
// Use Client->new_request() instead.
//
Request.make :: #match #local {}

#overload
Request.make :: (method: Method, url: str) -> &Request {
    req := new(Request.{
        allocator = context.allocator,
        method = method,
    })

    if u := destructure_url(url); u {
        req.url = u->unwrap()
    }

    return req
}

#overload
Request.make :: () -> &Request {
    return new(Request.{context.allocator})
}

Request.free :: (r: &Request) {
    r.headers->free()
    r.cookies->free()

    if r.owned_query do delete(&r.owned_query)
    if r.owned_body do delete(&r.owned_body)
    if r.owned_method do delete(&r.owned_method)
    if r.url_storage do delete(&r.url_storage)

    r.allocator->free(r)
}

#overload
__dispose_used_local :: macro (r: & &Request) {
    r.*->free()
}

Request.set_url :: (r: &Request, url: str) {
    u := destructure_url(url)
    if u {
        r.url = u->unwrap()
    }
}

Request.set_method :: #match {
    (r: &Request, method: Method) {
        r.method = method
        if r.owned_method do delete(&r.owned_method)
        r.custom_method = ""
    }

    (r: &Request, method: str) {
        if r.owned_method do delete(&r.owned_method)
        r.owned_method = copy_str(method)
        r.custom_method = r.owned_method
        r.method = .Custom
    }
}

Request.verb :: (r: &Request) -> str {
    if r.custom_method do return r.custom_method
    return r.method->as_str()
}

Request.set_cookie :: (r: &Request, key, value: str) {
    r.cookies->set(.{ key, value })
}

Request.set_query :: (r: &Request, q: &Query) {
    if q.entries.count == 0 do return

    combined: Query
    defer combined->free()
    if r.url.rawQuery do combined->parse_encoded(r.url.rawQuery)

    kept: [..] QueryParam
    for & existing in combined.entries {
        replaced := false
        for & incoming in q.entries {
            if incoming.key == existing.key do replaced = true
        }
        if replaced {
            delete(&existing.key)
            delete(&existing.value)
        } else {
            kept << *existing
        }
    }
    delete(&combined.entries)
    combined.entries = kept

    for & q.entries {
        combined.entries << .{ copy_str(it.key), copy_str(it.value) }
    }

    if r.owned_query do delete(&r.owned_query)
    encoded := combined->encode()
    r.owned_query = copy_str(encoded)
    r.url.rawQuery = r.owned_query
}

Request.set_basic_auth :: (r: &Request, user, pass: str) {
    raw := core.tprintf("{}:{}", user, pass)
    encoded := base64.encode(raw)
    defer delete(&encoded)
    r.headers->set("Authorization", core.tprintf("Basic {}", encoded))
}

Request.set_bearer :: (r: &Request, token: str) {
    r.headers->set("Authorization", core.tprintf("Bearer {}", token))
}

Request.set_form_urlencoded :: (r: &Request, q: &Query) {
    if r.owned_body do delete(&r.owned_body)

    r.owned_body = copy_str(q->encode())
    r.body = r.owned_body
    r.form = null
    r.headers->set("Content-Type", "application/x-www-form-urlencoded")
}

Request.set_body :: #match {
    (r: &Request, body: str) {
        r.body = body
        r.body_stream = null
    }
}

Request.set_body_stream :: #match {
    (r: &Request, body: &io.Stream) {
        r.body_stream = body
        r.body_length = .{}
        r.body = .{}
        r.form = null
    }

    (r: &Request, body: &io.Stream, length: i64) {
        r.body_stream = body
        r.body_length = length
        r.body = .{}
        r.form = null
    }
}

Request.set_form :: (r: &Request, form: &FormData) {
    r.headers->set("Content-Type", core.tprintf("multipart/form-data; boundary={\"}", form->get_boundary()))
    r.form = form

    // Clear the body, because the form replaces it.
    r.body = .{}
}

Request.write :: (r: &Request, w: &io.Writer) -> bool {
    w->consume_error()

    w->write_format( "{} ", r->verb())
    if r.use_absolute_form {
        scheme := "https" if r.url.protocol->is_https() else "http"
        w->write_format( "{}://", scheme)
        if str.contains(r.url.host, #char ":") {
            w->write_format( "[{}]", r.url.host)
        } else {
            w->write( r.url.host)
        }
        if r.url.port != 0 && r.url.port != r.url.protocol->default_port() {
            w->write_format( ":{}", r.url.port)
        }
        w->write( r.url.resource)
    } else {
        w->write( r.url.resource)
    }
    
    if r.url.rawQuery {
        w->write_format( "?{}", r.url.rawQuery)
    }

    w->write_format( " {}\r\n", str.as_str(r.url.protocol))

    if str.contains(r.url.host, #char ":") {
        w->write_format( "Host: [{}]", r.url.host)
    } else {
        w->write_format( "Host: {}", r.url.host)
    }
    if r.url.port != 0 && r.url.port != r.url.protocol->default_port() {
        w->write_format( ":{}", r.url.port)
    }
    w->write( "\r\n")

    r.cookies->write_header(r.url, w)

    if r.proxy_authorization {
        w->write_format( "Proxy-Authorization: {}\r\n", r.proxy_authorization)
    }

    if r.body_stream {
        if r.body_length {
            length := r.body_length->unwrap()
            if length < 0 do return false
            r.headers->delete("transfer-encoding")
            r.headers->set("Content-Length", core.tprintf("{}", length))
        } else {
            r.headers->delete("content-length")
            r.headers->set("Transfer-Encoding", "chunked")
        }

        r.headers->write(w)
        w->write( "\r\n")
        w->flush()
        if w->consume_error() != .None do return false

        if r.body_length {
            return write_stream_length(w.stream, r.body_stream, r.body_length->unwrap())
        }
        return write_stream_chunked(w.stream, r.body_stream)
    }

    if r.form && !r.body {
        length := r.form->encoded_length()
        if !length do return false
        r.headers->set("Content-Length", core.tprintf("{}", length->unwrap()))
        r.headers->write(w)
        w->write( "\r\n")
        if !r.form->write(w) do return false
        w->flush()
        return w->consume_error() == .None
    }

    body := r.body ?? do {
        if !r.form do return null_str

        w, sb := io.Writer.string_builder()
        defer delete(sb)

        r.form->write(&w)

        return str.temp_copy(str.as_str(sb))
    }

    r.headers->set("Content-Length", core.tprintf("{}", body.count))

    r.headers->write(w)

    w->write( "\r\n")
    if body {
        w->write( body)
    }

    w->flush()

    return w->consume_error() == .None
}


#overload
Request.set_body :: (r: &Request, v: json.Value) {
    encoded_string := json.encode_string(v)!
    r.body = encoded_string
    r.body_stream = null
}

#local
write_all :: (s: &io.Stream, buf: [] u8) -> bool {
    off: u32 = 0
    while off < buf.count {
        result := io.Stream.write(s, buf[off .. buf.count])
        if result.Err do return false
        n := result.Ok->unwrap()
        if n == 0 do return false
        off += n
    }
    return true
}

#local
write_stream_length :: (dst, src: &io.Stream, length: i64) -> bool {
    left := length
    buf: [1024] u8
    while left > 0 {
        want: u32 = 1024
        if left < 1024 do want = ~~left

        result := io.Stream.read(src, buf[0 .. want])
        if result.Err do return false
        n := result.Ok->unwrap()
        if n == 0 do return false
        if !write_all(dst, buf[0 .. n]) do return false
        left -= cast(i64) n
    }
    return true
}

#local
write_stream_chunked :: (dst, src: &io.Stream) -> bool {
    buf: [1024] u8
    while true {
        result := io.Stream.read(src, buf)
        if result.Err {
            if result.Err->unwrap() != .EOF do return false
            break
        }
        n := result.Ok->unwrap()
        if n == 0 do break
        if !write_chunk(dst, buf[0 .. n]) do return false
    }
    return write_all(dst, "0\r\n\r\n")
}

#local
write_chunk :: (dst: &io.Stream, data: [] u8) -> bool {
    hexbuf: [32] u8
    hex := conv.format_int(cast(i64) data.count, 16, hexbuf)
    if !write_all(dst, hex) do return false
    if !write_all(dst, "\r\n") do return false
    if !write_all(dst, data) do return false
    return write_all(dst, "\r\n")
}

