package http.client

#load "../module"

use core
use core.test
use core.os
use core {io, string, Result, time, net}

@core.test.test.{"url"}
url_parses_host_port_query :: (t: &core.test.T) {
    u := destructure_url("https://example.com:8443/a/b?x=1#frag")->unwrap()
    t->assert(u.protocol == .HTTPS11, "protocol")
    t->assert(u.host == "example.com", "host")
    t->assert(u.port == 8443, "port")
    t->assert(u.resource == "/a/b", "resource")
    t->assert(u.rawQuery == "x=1", "query")
    t->assert(u.fragment == "frag", "fragment")
}

@core.test.test.{"url ipv6"}
url_parses_ipv6 :: (t: &core.test.T) {
    u := destructure_url("http://[::1]:8080/a?b=1#f")->unwrap()
    t->assert(u.protocol == .HTTP11, "protocol")
    t->assert(u.host == "::1", "host")
    t->assert(u.port == 8080, "port")
    t->assert(u.resource == "/a", "resource")
    t->assert(u.rawQuery == "b=1", "query")
    t->assert(u.fragment == "f", "fragment")

    bare := destructure_url("https://[::1]/")->unwrap()
    t->assert(bare.host == "::1", "bare host")
    t->assert(bare.port == 443, "bare port")
    t->assert(bare.resource == "/", "bare resource")
}

@core.test.test.{"url rejects"}
url_rejects_bad_input :: (t: &core.test.T) {
    t->assert(!destructure_url("http://example.com:abc/"), "bad port")
    authed := destructure_url("http://user:pass@example.com/a")->unwrap()
    t->assert(authed.user == "user", "userinfo user")
    t->assert(authed.pass == "pass", "userinfo pass")
    t->assert(authed.host == "example.com", "userinfo host")
    t->assert(authed.resource == "/a", "userinfo path")
    t->assert(!destructure_url("ftp://example.com/"), "scheme")
    t->assert(!destructure_url("http://[::1/"), "unclosed ipv6")
}

@core.test.test.{"urlencode"}
urlencode_round_trip :: (t: &core.test.T) {
    encoded := urlencode("a b/c%")
    defer delete(&encoded)
    t->assert(encoded == "a%20b%2Fc%25", "encode")

    decoded := urldecode("%41+%2f")
    defer delete(&decoded)
    t->assert(decoded == "A /", "decode")
}

@core.test.test.{"redirects"}
redirect_urls :: (t: &core.test.T) {
    base := destructure_url("http://example.com/a/b")->unwrap()

    rel := resolve_redirect(base, "c")
    defer delete(&rel)
    t->assert(rel == "http://example.com/a/c", "relative")

    abs := resolve_redirect(base, "/c")
    defer delete(&abs)
    t->assert(abs == "http://example.com/c", "absolute path")

    query := resolve_redirect(base, "?x=1")
    defer delete(&query)
    t->assert(query == "http://example.com/a/b?x=1", "query")

    other := resolve_redirect(base, "https://other/x")
    defer delete(&other)
    t->assert(other == "https://other/x", "absolute")

    scheme := resolve_redirect(base, "//cdn.example/x")
    defer delete(&scheme)
    t->assert(scheme == "http://cdn.example/x", "scheme relative")

    v6 := destructure_url("http://[::1]:8080/a")->unwrap()
    v6_next := resolve_redirect(v6, "/b")
    defer delete(&v6_next)
    t->assert(v6_next == "http://[::1]:8080/b", "ipv6")

    t->assert(method_for_redirect(301, .Post) == .Get, "301")
    t->assert(method_for_redirect(302, .Post) == .Get, "302")
    t->assert(method_for_redirect(303, .Put) == .Get, "303")
    t->assert(method_for_redirect(307, .Post) == .Post, "307")
    t->assert(method_for_redirect(308, .Put) == .Put, "308")
    t->assert(method_for_redirect(301, .Head) == .Head, "301 head")
    t->assert(method_for_redirect(303, .Head) == .Head, "303 head")
    t->assert(method_for_redirect(301, .Patch) == .Get, "301 patch")
    t->assert(method_for_redirect(307, .Patch) == .Patch, "307 patch")

    dot := resolve_redirect(base, "../c")
    defer delete(&dot)
    t->assert(dot == "http://example.com/c", "dot segments")

    t->assert(!should_retry_reused(.Post, "", false, .Timeout), "post timeout")
    t->assert(should_retry_reused(.Post, "", false, .WriteFailed), "post write")
    t->assert(should_retry_reused(.Get, "", false, .Timeout), "get timeout")
    t->assert(!should_retry_reused(.Post, "", true, .WriteFailed), "streamed")
    t->assert(!should_retry_reused(.Custom, "PROPFIND", false, .Timeout), "custom")
}

@core.test.test.{"response"}
response_parser :: (t: &core.test.T) {
    simple := parse_fixture("HTTP/1.1 200 OK\r\nContent-Type:text/plain\r\nContent-Length: 5\r\n\r\nhello", .Get)
    t->assert(simple->is_ok(), "simple ok")
    resp := simple!
    defer resp->free()
    t->assert(resp.status == 200, "status")
    t->assert(resp->is_success(), "success")
    t->assert(resp.headers->get("content-type") == "text/plain", "header space")
    t->assert(resp.body == "hello", "body")
    t->assert(!resp.must_close, "keep alive")

    chunked := parse_fixture("HTTP/1.1 200 OK\r\nTransfer-Encoding: Chunked\r\n\r\n5\r\nhello\r\n0\r\nX-Trail: 1\r\n\r\n", .Get)
    t->assert(chunked->is_ok(), "chunked ok")
    if chunked->is_ok() {
        body := chunked!
        defer body->free()
        t->assert(body.body == "hello", "chunked")
    }

    head := parse_fixture("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello", .Head)
    t->assert(head->is_ok(), "head ok")
    if head->is_ok() {
        body := head!
        defer body->free()
        t->assert(body.body.count == 0, "head body")
    }

    empty := parse_fixture("HTTP/1.1 204 No Content\r\nContent-Length: 5\r\n\r\nhello", .Get)
    t->assert(empty->is_ok(), "204 ok")
    if empty->is_ok() {
        body := empty!
        defer body->free()
        t->assert(body.body.count == 0, "204")
        t->assert(body->is_success(), "204 success")
    }

    closed := parse_fixture("HTTP/1.0 200 OK\r\n\r\nhello", .Get)
    t->assert(closed->is_ok(), "eof ok")
    if closed->is_ok() {
        body := closed!
        defer body->free()
        t->assert(body.body == "hello", "eof body")
        t->assert(body.must_close, "http/1.0 close")
        t->assert(body.protocol == .HTTP10, "http/1.0")
    }

    conn := parse_fixture("HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: Close\r\n\r\n", .Get)
    t->assert(conn->is_ok(), "connection ok")
    if conn->is_ok() {
        body := conn!
        defer body->free()
        t->assert(body.must_close, "connection close")
    }

    cont := parse_fixture("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 201 Created\r\nContent-Length: 2\r\n\r\nok", .Post)
    t->assert(cont->is_ok(), "100 ok")
    if cont->is_ok() {
        body := cont!
        defer body->free()
        t->assert(body.status == 201, "skip 100")
        t->assert(body.body == "ok", "after 100")
        t->assert(body->is_success(), "201 success")
    }

    bad := parse_fixture("NOT HTTP\r\n\r\n", .Get)
    t->assert(bad->is_err(), "bad status")
}

@core.test.test.{"cookies"}
cookie_jar_filters :: (t: &core.test.T) {
    jar := CookieJar.make()
    defer jar->free()

    headers := Headers.make()
    defer headers->free()
    headers->add("set-cookie", "a=1; Domain=example.com; Path=/app; Secure")
    headers->add("set-cookie", "b=2; Path=/")
    headers->add("set-cookie", "c=3; Max-Age=0")
    headers->add("set-cookie", "d=4; Expires=Tue, 01 Jan 1980 00:00:00 GMT")

    url := destructure_url("https://www.example.com/app/index")->unwrap()
    jar->ingress_from_headers(headers, url)

    https := capture_cookie_header(&jar, url)
    defer delete(&https)
    t->assert(str.contains(https, "a=1"), "domain cookie on subdomain")
    t->assert(str.contains(https, "b=2"), "host cookie")
    t->assert(!str.contains(https, "c=3"), "max-age 0")
    t->assert(!str.contains(https, "d=4"), "expired")

    other := destructure_url("https://evil.com/app")->unwrap()
    other_header := capture_cookie_header(&jar, other)
    defer delete(&other_header)
    t->assert(!str.contains(other_header, "a=1"), "not cross host")
    t->assert(!str.contains(other_header, "b=2"), "host-only")

    http := destructure_url("http://www.example.com/app")->unwrap()
    http_header := capture_cookie_header(&jar, http)
    defer delete(&http_header)
    t->assert(!str.contains(http_header, "a=1"), "secure not on http")
    t->assert(str.contains(http_header, "b=2"), "non-secure on http")

    other_path := destructure_url("https://www.example.com/other")->unwrap()
    path_header := capture_cookie_header(&jar, other_path)
    defer delete(&path_header)
    t->assert(!str.contains(path_header, "a=1"), "path mismatch")
    t->assert(str.contains(path_header, "b=2"), "root path")

    jar->set(.{ "explicit", "yes" })
    explicit := capture_cookie_header(&jar, other)
    defer delete(&explicit)
    t->assert(str.contains(explicit, "explicit=yes"), "explicit any host")
}

@core.test.test.{"request"}
request_host_and_form :: (t: &core.test.T) {
    req := new_request(.Get, "http://[::1]:8080/a")
    defer req->free()
    req.headers = Headers.make()
    req.cookies = CookieJar.make()

    w, sb := io.Writer.string_builder()
    t->assert(req->write(&w), "write")
    written := str.as_str(sb)
    t->assert(str.contains(written, "Host: [::1]:8080\r\n"), "host header")

    q := Query.{}
    defer q->free()
    q->set("a", "b c")
    req->set_form_urlencoded(&q)
    t->assert(req.headers->get("content-type") == "application/x-www-form-urlencoded", "form type")
    t->assert(req.body->unwrap() == "a=b%20c", "form body")

    req->set_basic_auth("user", "pass")
    t->assert(req.headers->get("authorization") == "Basic dXNlcjpwYXNz", "basic")
    req->set_bearer("tok")
    t->assert(req.headers->get("authorization") == "Bearer tok", "bearer")
}

@core.test.test.{"stream request"}
stream_request_write :: (t: &core.test.T) {
    req := new_request(.Post, "http://example.com/upload")
    defer req->free()
    req.headers = Headers.make()
    req.cookies = CookieJar.make()

    payload := "hello"
    stream := io.BufferStream.make(payload, write_enabled=false)
    req->set_body_stream(&stream, 5)

    w, sb := io.Writer.string_builder()
    t->assert(req->write(&w), "length write")
    written := str.as_str(sb)
    t->assert(str.contains(written, "Content-Length: 5\r\n"), "length header")
    t->assert(str.contains(written, "\r\n\r\nhello"), "length body")
    t->assert(!str.contains(written, "Transfer-Encoding"), "no chunked")

    extra := io.BufferStream.make("helloEXTRA", write_enabled=false)
    req->set_body_stream(&extra, 5)
    w2, sb2 := io.Writer.string_builder()
    t->assert(req->write(&w2), "truncated write")
    t->assert(str.contains(str.as_str(sb2), "\r\n\r\nhello"), "stopped at length")
    t->assert(!str.contains(str.as_str(sb2), "EXTRA"), "did not read past length")

    chunked_stream := io.BufferStream.make("hello", write_enabled=false)
    req->set_body_stream(&chunked_stream)
    w3, sb3 := io.Writer.string_builder()
    t->assert(req->write(&w3), "chunked write")
    chunked := str.as_str(sb3)
    t->assert(str.contains(chunked, "Transfer-Encoding: chunked\r\n"), "chunked header")
    t->assert(!str.contains(chunked, "Content-Length"), "no length")
    t->assert(str.contains(chunked, "\r\n\r\n5\r\nhello\r\n0\r\n\r\n"), "chunk framing")
}

@core.test.test.{"api gaps"}
api_gaps :: (t: &core.test.T) {
    jar := CookieJar.make()
    defer jar->free()
    headers := Headers.make()
    defer headers->free()
    headers->add("set-cookie", "a=1; Domain=com")
    headers->add("set-cookie", "b=2; Domain=co.uk")
    headers->add("set-cookie", "c=3; Domain=example.com")
    url := destructure_url("https://example.com/")->unwrap()
    jar->ingress_from_headers(headers, url)
    header := capture_cookie_header(&jar, url)
    defer delete(&header)
    t->assert(!str.contains(header, "a=1"), "public suffix tld")
    t->assert(!str.contains(header, "b=2"), "public suffix multi")
    t->assert(str.contains(header, "c=3"), "registrable domain")
    t->assert(is_public_suffix("com"), "com")
    t->assert(is_public_suffix("foo.amazonaws.com"), "wildcard")
    t->assert(!is_public_suffix("example.com"), "registrable")

    req := new_request(.Get, "http://example.com/a?b=1")
    defer req->free()
    req.headers = Headers.make()
    req.cookies = CookieJar.make()
    q := Query.{}
    defer q->free()
    q->add("id", "1")
    q->add("id", "2")
    req->set_query(&q)
    t->assert(req.url.rawQuery == "b=1&id=1&id=2", "merged query")

    req->set_method("PROPFIND")
    w, sb := io.Writer.string_builder()
    t->assert(req->write(&w), "custom write")
    t->assert(str.starts_with(str.as_str(sb), "PROPFIND /a?"), "custom verb")
    t->assert(req.method->as_str() == "" || req->verb() == "PROPFIND", "verb")

    patch := new_request(.Patch, "http://example.com/a")
    defer patch->free()
    t->assert(patch.method->as_str() == "PATCH", "patch")

    resp := Response.make()
    defer resp->free()
    resp.status = 404
    resp.url = copy_str("http://example.com/missing")
    failed := resp->error_for_status()
    t->assert(failed->is_err(), "status error")
    if failed.Err as err {
        t->assert(err.status == 404, "status code")
        t->assert(err.url == "http://example.com/missing", "status url")
    }
    resp.status = 204
    ok := resp->error_for_status()
    t->assert(ok->is_ok(), "204 ok")

    t->assert(no_proxy_matches("example.com", "example.com, other"), "no proxy exact")
    t->assert(no_proxy_matches("a.example.com", ".example.com"), "no proxy suffix")
    t->assert(no_proxy_matches("example.com", "*"), "no proxy star")
    t->assert(!no_proxy_matches("example.com", "other.com"), "no proxy miss")

    form := FormData.{}
    defer form->free()
    form->attach("a", "hi")
    length := form->encoded_length()
    length_ok := false
    if length do length_ok = true
    t->assert(length_ok, "form length")
    fw, fsb := io.Writer.string_builder()
    t->assert(form->write(&fw), "form write")
    fw->flush()
    written := str.as_str(fsb)
    if length do t->assert(cast(i64) written.count == length->unwrap(), "form length matches")
    t->assert(str.contains(written, "name=\"a\""), "form name")
    t->assert(str.contains(written, "hi"), "form value")

    path := "/tmp/onyx-http-client-multipart.txt"
    payload := "file-bytes"
    t->assert(os.File.write_contents(path, payload), "write temp")
    defer os.File.remove(path)
    file_form := FormData.{}
    defer file_form->free()
    file_form->attach_path("f", path, "text/plain")
    file_length := file_form->encoded_length()
    file_writer, file_builder := io.Writer.string_builder()
    t->assert(file_form->write(&file_writer), "path write")
    file_writer->flush()
    file_written := str.as_str(file_builder)
    if file_length do t->assert(cast(i64) file_written.count == file_length->unwrap(), "path length")
    t->assert(str.contains(file_written, "filename=\"onyx-http-client-multipart.txt\""), "filename")
    t->assert(str.contains(file_written, payload), "file bytes")
}

@core.test.test.{"dial"}
dial_respects_deadline :: (t: &core.test.T) {
    refused := dial_timeout("127.0.0.1", 1, time.Instant.now() + 1000 * time.MILLISECOND)
    if refused.Ok as sock {
        net.socket_close(&sock)
    }
    t->assert(refused->is_err(), "refused")

    start := time.Instant.now()
    blackhole := dial_timeout("192.0.2.1", 81, start + 250 * time.MILLISECOND)
    elapsed := time.Instant.now() - start
    t->assert(blackhole->is_err(), "blackhole")
    t->assert(elapsed < 2 * time.SECOND, "blackhole bounded")
    if blackhole.Err as err {
        t->assert(err == .Timeout, "blackhole timeout")
    }
}

@core.test.test.{"gzip"}
gunzip_vectors :: (t: &core.test.T) {
    hello := u8.[
        31, 139, 8, 0, 69, 210, 255, 106, 2, 255, 203, 72, 205, 201, 201, 87, 72, 175, 202, 44, 0, 0, 25, 106, 210, 223, 10, 0, 0, 0,
    ]
    decoded := gunzip(hello)
    hello_ok := false
    if decoded do hello_ok = true
    t->assert(hello_ok, "hello decodes")
    if decoded {
        body := decoded->unwrap()
        defer delete(&body)
        t->assert(body == "hello gzip", "hello bytes")
    }

    empty := u8.[31, 139, 8, 0, 69, 210, 255, 106, 2, 255, 3, 0, 0, 0, 0, 0, 0, 0, 0, 0]
    empty_body := gunzip(empty)
    empty_ok := false
    if empty_body do empty_ok = true
    t->assert(empty_ok, "empty decodes")
    if empty_body {
        body := empty_body->unwrap()
        defer delete(&body)
        t->assert(body.count == 0, "empty payload")
    }

    repeated := u8.[
        31, 139, 8, 0, 69, 210, 255, 106, 2, 255, 75, 76, 74, 78, 196, 134, 0, 55, 15, 32, 1, 24, 0, 0, 0,
    ]
    rep := gunzip(repeated)
    rep_ok := false
    if rep do rep_ok = true
    t->assert(rep_ok, "repeat decodes")
    if rep {
        body := rep->unwrap()
        defer delete(&body)
        t->assert(body == "abcabcabcabcabcabcabcabc", "repeat bytes")
    }

    fox := u8.[
        31, 139, 8, 0, 69, 210, 255, 106, 2, 255, 11, 201, 72, 85, 40, 44, 205, 76, 206, 86, 72, 42, 202, 47, 207, 83, 72, 203, 175, 80, 200, 42, 205, 45, 40, 86, 200, 47, 75, 45, 82, 40, 1, 74, 231, 36, 86, 85, 42, 164, 228, 167, 235, 41, 132, 140, 42, 30, 85, 60, 170, 152, 218, 138, 1, 230, 74, 102, 176, 132, 3, 0, 0,
    ]
    fox_body := gunzip(fox)
    fox_ok := false
    if fox_body do fox_ok = true
    t->assert(fox_ok, "dynamic decodes")
    if fox_body {
        body := fox_body->unwrap()
        defer delete(&body)
        t->assert(body.count == 900, "dynamic length")
        t->assert(str.starts_with(body, "The quick brown fox"), "dynamic prefix")
    }

    t->assert(content_is_gzip("gzip"), "gzip token")
    t->assert(content_is_gzip("GZip, deflate"), "gzip list")
    t->assert(!content_is_gzip("deflate"), "not deflate")
    t->assert(!gunzip("not gzip"), "rejects plain")
}

@core.test.test.{"stream response"}
stream_response_read :: (t: &core.test.T) {
    resp := Response.make()
    defer resp->free()
    resp.body = "hello"
    buf: [2] u8
    n := resp->read(buf)!
    t->assert(n == 2 && buf[0] == #char "h", "first")
    n = resp->read(buf)!
    t->assert(n == 2 && buf[0] == #char "l", "second")
    rest := resp->read(buf)!
    t->assert(rest == 1, "tail")
    t->assert(resp->read(buf)! == 0, "eof")

    raw := "5\r\nhello\r\n0\r\n\r\n"
    stream := io.BufferStream.make(raw, write_enabled=false)
    reader := io.Reader.make(&stream)
    defer io.Reader.free(&reader)

    headers := Headers.make()
    headers->set("transfer-encoding", "chunked")
    framed := Response.make()
    defer framed->free()
    framed.headers = headers
    framed.status = 200
    decoder := Body_Decoder.from_response(framed, .Get)

    out: [8] u8
    total: u32 = 0
    while total < 5 {
        n := decoder->read(&reader, out[total .. total + 2])!
        t->assert(n > 0, "chunk byte")
        total += n
    }
    t->assert(out[0 .. 5] == "hello", "chunked payload")
    t->assert(decoder->read(&reader, out)! == 0, "chunked eof")
    t->assert(decoder->done(), "chunked done")

    short := io.BufferStream.make("hi", write_enabled=false)
    short_reader := io.Reader.make(&short)
    defer io.Reader.free(&short_reader)
    length_headers := Headers.make()
    length_headers->set("content-length", "5")
    length_resp := Response.make()
    defer length_resp->free()
    length_resp.headers = length_headers
    length_resp.status = 200
    length_decoder := Body_Decoder.from_response(length_resp, .Get)
    early := length_decoder->read(&short_reader, out)
    failed := false
    if early.Err do failed = true
    t->assert(failed, "early eof")
}

#local
parse_fixture :: (raw: str, method: Method) -> Result(&Response, Error) {
    stream := io.BufferStream.make(raw, write_enabled=false)
    reader := io.Reader.make(&stream)
    defer io.Reader.free(&reader)
    return parse_response(&reader, method)
}

#local
capture_cookie_header :: (jar: &CookieJar, url: Url) -> str {
    w, sb := io.Writer.string_builder()
    jar->write_header(url, &w)
    w->flush()
    return copy_str(str.as_str(sb))
}
